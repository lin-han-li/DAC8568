; *************************************************************
; *** LEGACY UNUSED SCATTER FILE                            ***
; *************************************************************
; Active Keil target uses STM32H750XBH6_d2.sct.
; Do not select this file for the H750XBH6 demo build.

LR_IROM1 0x08000000 0x00020000  {    ; legacy 128KB internal flash layout
  ER_IROM1 0x08000000 0x00020000  {  ; load address = execution address
   *.o (RESET, +First)
   *(InRoot$$Sections)
   .ANY (+RO)
   .ANY (+XO)
  }
  RW_IRAM2 0x24000000 0x00080000  {  ; AXI SRAM (for DMA buffers)
   *(.axi_sram)
   *(.axi_sram*)
  }
  RW_IRAM1 0x20000000 0x00020000  {  ; DTCM RAM
   .ANY (+RW +ZI)
  }
}
